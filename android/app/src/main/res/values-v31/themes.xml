<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31+) Launch Splash Screen Theme -->
    <style name="Theme.EkaHub" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Android 12+ Window Splash Screen Specification -->
        <item name="android:windowSplashScreenBackground">@color/background_dark</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/background_dark</item>
        <item name="android:windowSplashScreenAnimationDuration">400</item>
    </style>
</resources>
